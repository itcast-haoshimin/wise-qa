# ============================================================
# agent_center 环境变量配置示例
#
# 使用方法：
#   1. 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略）
#   2. 应用启动时会自动加载项目根目录下的 .env 文件
#   3. 请勿将真实密钥提交到版本库
# ============================================================

# MySQL（agent_center 库，完整连接 URL）
DB_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/agent_center?charset=utf8mb4&connect_timeout=10

# JWT RSA 密钥（Base64 字符串，不含 PEM 头尾）
JWT_PRIVATE_KEY=your-private-key-base64
JWT_PUBLIC_KEY=your-public-key-base64

# LangGraph Checkpointer 会话记忆使用的 PostgreSQL（完整连接 URL）
POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=disable

# Redis
REDIS_PASSWORD=your-redis-password

# Nacos
NACOS_USERNAME=nacos
NACOS_PASSWORD=your-nacos-password

# LLM（通义千问，OpenAI 兼容接口）
ALIYUN_API_KEY=your-aliyun-api-key
